# Service Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Embedding & LLM Provider (Optional fallback to local deterministic if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Synthesis LLM backend: "local_cli" (default) shells out to a locally
# installed AI CLI — no API key required. "template" uses the deterministic
# rule-based sentence assembler only (no LLM call at all).
LLM_BACKEND=local_cli
# Fallback chain tried in order until one succeeds. Requires the binaries
# (claude / antigravity / opencode) to be installed and on PATH.
LOCAL_CLI_PROVIDER_ORDER=claude,antigravity,opencode
LOCAL_CLI_TIMEOUT_CLAUDE=60
LOCAL_CLI_TIMEOUT_ANTIGRAVITY=120
LOCAL_CLI_TIMEOUT_OPENCODE=240

# Retrieval & Hybrid Search
HYBRID_BM25_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5
RRF_K=60
RETRIEVAL_TOP_K=5

# MCP Server Settings
MCP_SERVER_NAME=financial-tools
MCP_SERVER_VERSION=1.0.0

# Citation & Verification
CITATION_MIN_CONFIDENCE=0.70
MAX_VERIFICATION_RETRIES=2
