# ==============================================================================
# AWS Lambda Container with AWS Lambda Web Adapter (Native Response Streaming)
# ==============================================================================

FROM public.ecr.aws/docker/library/python:3.12-slim

# Copy AWS Lambda Web Adapter binary
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.8.4 /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /var/task

ENV PORT=8000
ENV AWS_LWA_PORT=8000
ENV AWS_LWA_INVOKE_MODE=response_stream
ENV AWS_LWA_READ_TIMEOUT_MS=60000
ENV DATA_SOURCE_MODE=live_api
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir .

COPY config/ /var/task/config/
COPY src/ /var/task/src/
COPY data/ /var/task/data/

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
